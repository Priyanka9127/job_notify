# Database URL: Leave blank for local SQLite (sqlite:///./jobs.db), or paste your PostgreSQL connection string
# Example for Supabase / Neon: postgresql://user:password@ep-host.region.neon.tech/dbname?sslmode=require
DATABASE_URL=

# VAPID Keys for Web Push Notifications (auto-generated by backend on first run if left blank)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@sarkarinotifier.com

# Frontend origin URL for CORS
FRONTEND_URL=http://localhost:5173

# Server Port (default: 8000)
PORT=8000
